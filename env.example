# PostgreSQL connection string
# Local example:    postgres://postgres:postgres@localhost:5432/bazzo
# Hosted (Render/Railway/Supabase/Neon) — copy the connection string they give you.
DATABASE_URL=postgres://user:password@host:5432/bazzo

# Set to "true" only if your provider requires SSL but gives a
# self-signed cert (common on Render/Railway/Heroku-style hosts).
PGSSL=true

# Port the API listens on (most hosts set this for you automatically)
PORT=3000

# Comma-separated list of origins allowed to call the API.
# Use "*" while developing; lock it down once you have a real frontend URL.
CORS_ORIGIN=*

# Anthropic API key, used by the AI CV/resume builder (/api/cv/generate).
# Get one at https://console.anthropic.com/settings/keys
# Leave blank to disable the feature (it returns a clear error instead of crashing).
ANTHROPIC_API_KEY=

# Secret used to sign login sessions (JWTs). Use a long random string —
# e.g. run `openssl rand -hex 32` — and never reuse it across projects.
# Leave blank to disable accounts (routes return a clear error instead of crashing).
JWT_SECRET=

# Public HTTPS URL of this deployed backend — used to build the link inside
# verification emails (e.g. https://bazzo-careers.onrender.com). No trailing
# slash. If unset, falls back to MPESA_CALLBACK_BASE_URL.
APP_BASE_URL=

# --- M-Pesa (Safaricom Daraja API) — charges job seekers to apply via STK
# push. The full fee goes straight into the M-Pesa account behind
# MPESA_SHORTCODE (your paybill/till — see README for how that connects to
# +254 710 929 595). Leave APPLICATION_FEE_KES=0 to keep applying free.
APPLICATION_FEE_KES=50

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a public HTTPS URL Safaricom can reach (your deployed backend) —
# localhost will not work. No trailing slash.
MPESA_CALLBACK_BASE_URL=

# --- Owner notifications: sent to you automatically the moment a payment is
# confirmed. Each channel is independent and optional — set either, both, or
# neither. See README for setup. Leave both blank to skip notifications.
OWNER_EMAIL=
OWNER_NOTIFY_PHONE=254710929595

# Email (any SMTP provider — Gmail, Outlook, Zoho, your own mail server, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bazzo Careers Team <no-reply@example.com>

# SMS (Africa's Talking — the standard way to send SMS to Kenyan numbers via API)
# Use AFRICASTALKING_USERNAME=sandbox while testing (free, no real SMS sent).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
